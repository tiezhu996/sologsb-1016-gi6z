{
  "name": "sologsb-1016-radio-drama-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:merge": "esbuild scripts/entry.ts --bundle --format=esm --outfile=scripts/bundle.mjs --log-level=warning && node scripts/merge.test.mjs",
    "test:studio": "esbuild scripts/studio-entry.ts --bundle --format=esm --outfile=scripts/studio-bundle.mjs --log-level=warning --external:vue && node scripts/studio.test.mjs",
    "test": "npm run test:merge && npm run test:studio"
  },
  "dependencies": {
    "naive-ui": "^2.40.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
